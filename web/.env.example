NEXT_PUBLIC_SITE_URL=https://startup2-self.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://cfpucfhjyitxxhbmfnrc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# HeadHunter: create an application at https://dev.hh.ru/admin
HH_CLIENT_ID=your_hh_client_id
HH_CLIENT_SECRET=your_hh_client_secret
# Optional alternative to client credentials:
# HH_ACCESS_TOKEN=your_hh_application_token
HH_USER_AGENT=JobPilot/0.2 (https://startup2-self.vercel.app)

# Server-only. Never prefix this key with NEXT_PUBLIC_.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-5.2

# Server-only Supabase secret key. Required for AI quotas and account deletion.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Agentic auto-apply. Create a 32-byte key: openssl rand -base64 32
# Keep this key stable; changing it makes connected hh.ru tokens unreadable.
AGENT_ENCRYPTION_KEY=your_base64_32_byte_key
# Vercel injects this bearer token into scheduled cron requests.
CRON_SECRET=your_random_cron_secret
# Register https://startup2-self.vercel.app/api/agent/hh/callback
# as the hh.ru OAuth redirect URI for the same HH_CLIENT_ID above.
